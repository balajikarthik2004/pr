{
  "name": "pr-guardrails-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox for testing strict PR guidelines + automated AI code review",
  "engines": { "node": ">=20" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run lint && npm run typecheck && npm run test:cov && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
